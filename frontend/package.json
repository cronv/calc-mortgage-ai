{
  "name": "mortgage-frontend",
  "version": "1.0.0",
  "description": "Ипотечный калькулятор: публичный SPA + встраиваемый виджет",
  "scripts": {
    "build:main": "ng build main-app --configuration=production",
    "build:widget": "ng build mortgage-widget --configuration=production",
    "build": "npm run build:main && npm run build:widget",
    "test": "ng test main-app --watch=false --browsers=ChromeHeadless",
    "lint": "ng lint",
    "update": "ng update @angular/core@22 @angular/cli@22"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/platform-browser-dynamic": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/router": "^22.0.0",
    "docx": "^9.7.1",
    "exceljs": "^4.4.0",
    "pdfmake": "^0.3.11",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.0",
    "@angular/cli": "^22.0.0",
    "@angular/compiler-cli": "^22.0.0",
    "@types/node": "^22.0.0",
    "typescript": "~5.9.0"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  }
}
