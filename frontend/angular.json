{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "main-app": {
      "projectType": "application",
      "root": "projects/main-app",
      "sourceRoot": "projects/main-app/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/main-app",
            "index": "projects/main-app/src/index.html",
            "browser": "projects/main-app/src/main.ts",
            "polyfills": [],
            "tsConfig": "projects/main-app/tsconfig.app.json",
            "assets": [],
            "styles": [
              "projects/main-app/src/styles.css"
            ],
            "scripts": [],
            "allowedCommonJsDependencies": [
              "exceljs",
              "pdfmake"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kb",
                  "maximumError": "1mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "10kb",
                  "maximumError": "14kb"
                }
              ],
              "outputHashing": "all",
              "optimization": {
                "scripts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": true
                },
                "fonts": {
                  "inline": false
                }
              }
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "buildTarget": "main-app:build"
          },
          "configurations": {
            "production": {
              "buildTarget": "main-app:build:production"
            },
            "development": {
              "buildTarget": "main-app:build:development"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    },
    "mortgage-widget": {
      "projectType": "application",
      "root": "projects/mortgage-widget",
      "sourceRoot": "projects/mortgage-widget/src",
      "prefix": "wdg",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/mortgage-widget",
            "index": "projects/mortgage-widget/src/index.html",
            "browser": "projects/mortgage-widget/src/main.ts",
            "polyfills": [],
            "tsConfig": "projects/mortgage-widget/tsconfig.app.json",
            "assets": [],
            "styles": [],
            "scripts": []
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "300kb",
                  "maximumError": "600kb"
                }
              ],
              "outputHashing": "none",
              "optimization": {
                "scripts": true,
                "styles": {
                  "minify": true
                },
                "fonts": {
                  "inline": false
                }
              }
            },
            "development": {
              "optimization": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        }
      }
    }
  },
  "cli": {
    "analytics": "0513e065-6d45-4810-8d59-1a1f8ebd0d03"
  }
}
