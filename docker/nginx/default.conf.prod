# CORS: Origin партнёра отражается обратно. В проде заменить на белый список доменов.
# Эта директива должна быть в http контексте, поэтому она уже определена в nginx.conf или отдельном файле
# map $http_origin $cors_origin { ... }

upstream php_fpm {
    server php:9000;
    keepalive 32;
}

# ========== HTTP → HTTPS редирект для основного домена и www ==========
server {
    listen 80;
    server_name ваш-домен.ru www.ваш-домен.ru;
    
    # HSTS preload - отправляем заголовок даже для HTTP (для последующих запросов)
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    
    return 301 https://$host$request_uri;
}

# ========== HTTP → HTTPS редирект для всех поддоменов ==========
server {
    listen 80;
    server_name ~^(?<subdomain>[a-z0-9_-]+)\.ваш-домен\.ru$;
    
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    
    # Проверяем существование папки поддомена
    if (!-d /var/www/$subdomain) {
        return 301 https://$host$request_uri;
    }
    
    return 301 https://$host$request_uri;
}

# ========== Catch-all для неизвестных доменов → редирект на основной домен ==========
server {
    listen 80;
    server_name _;
    
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    
    return 301 https://$host$request_uri;
}

# ========== Динамические поддомены: раздача контента из папок ==========
server {
    listen 443 ssl http2;
    server_name ~^(?<subdomain>[a-z0-9_-]+)\.ваш-домен\.ru$;

    # Пути к сертификатам (должны лежать в ./docker/nginx/ssl/)
    ssl_certificate /etc/nginx/ssl/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/privkey.pem;
    
    # Современные SSL настройки (TLS 1.2/1.3)
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;
    
    # OCSP Stapling (раскомментировать при использовании публичных сертификатов)
    # ssl_stapling on;
    # ssl_stapling_verify on;
    # resolver 8.8.8.8 8.8.4.4 valid=300s;
    # resolver_timeout 5s;

    # HSTS заголовок
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-XSS-Protection "1; mode=block" always;

    # Динамический root на основе имени поддомена
    root /var/www/$subdomain;
    index index.html;

    # Проверка существования папки поддомена - если нет, редирект на основной домен
    if (!-d /var/www/$subdomain) {
        return 301 https://$host$request_uri;
    }

    # ---------- API → Symfony front controller (PHP-FPM) ----------
    # Доступно для всех поддоменов
    include /etc/nginx/api_location.conf;

    # JS-скрипты с CORS заголовками
    location ~* ^(.+\.js)$ {
        add_header Content-Type application/javascript;
        add_header Access-Control-Allow-Origin "*" always;
        add_header Cache-Control "public, max-age=3600";
        try_files $uri =404;
    }

    # Остальные файлы
    location / {
        add_header Access-Control-Allow-Origin "*" always;
        try_files $uri $uri/ =404;
    }
}

# ========== Основной домен: главная страница + API ==========
server {
    listen 443 ssl http2;
    server_name ваш-домен.ru www.ваш-домен.ru; # ЗАМЕНИТЕ НА ВАШ ДОМЕН

    # Пути к сертификатам (должны лежать в ./docker/nginx/ssl/)
    ssl_certificate /etc/nginx/ssl/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/privkey.pem;
    
    # Современные SSL настройки (TLS 1.2/1.3)
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;
    
    # OCSP Stapling (раскомментировать при использовании публичных сертификатов)
    # ssl_stapling on;
    # ssl_stapling_verify on;
    # resolver 8.8.8.8 8.8.4.4 valid=300s;
    # resolver_timeout 5s;

    # HSTS и другие security заголовки
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-XSS-Protection "1; mode=block" always;
    
    root /var/www/main;
    index index.html;

    # ---------- API → Symfony front controller (PHP-FPM) ----------
    include /etc/nginx/api_location.conf;

    location ~ ^/index\.php(/|$) {
        fastcgi_pass php_fpm;
        fastcgi_split_path_info ^(.+\.php)(/.*)$;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME /var/www/html/public/index.php;
        fastcgi_param DOCUMENT_ROOT   /var/www/html/public;
        
        # Скрытие версии PHP
        fastcgi_hide_header X-Powered-By;
        
        internal;
    }

    # ---------- Статика SPA с длинным кэшем ----------
    location ~* \.(?:js|css|woff2|svg|png|jpg|jpeg|gif|ico)$ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }

    # ---------- SPA fallback ----------
    location / {
        try_files $uri $uri/ /index.html;
    }
}

# ========== Catch-all для неизвестных поддоменов на HTTPS → редирект на основной домен ==========
server {
    listen 443 ssl http2;
    server_name _;
    
    ssl_certificate /etc/nginx/ssl/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/privkey.pem;
    
    # Современные SSL настройки
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    
    return 301 https://$host$request_uri;
}
