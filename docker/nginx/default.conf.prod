# CORS: Origin партнёра отражается обратно. В проде заменить на белый список доменов.
map $http_origin $cors_origin {
    default "";
    "~.*"   $http_origin;
}

upstream php_fpm {
    server php:9000;
}

server {
    listen 80;
    server_name ваш-домен.ru www.ваш-домен.ru;
    return 301 https://$host$request_uri;
}

server {
    isten 443 ssl http2;
    server_name vash-domen.ru www.vash-domen.ru; # ЗАМЕНИТЕ НА ВАШ ДОМЕН

    # Пути к сертификатам (должны лежать в ./docker/nginx/ssl/)
    ssl_certificate /etc/nginx/ssl/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/privkey.pem;
    root /var/www/main;
    index index.html;

    # ---------- API → Symfony front controller (PHP-FPM) ----------
    location /api/ {
        if ($request_method = OPTIONS) {
            add_header Access-Control-Allow-Origin  $cors_origin always;
            add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
            add_header Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With" always;
            add_header Access-Control-Max-Age 3600 always;
            add_header Content-Length 0;
            return 204;
        }
        add_header Access-Control-Allow-Origin $cors_origin always;

        fastcgi_pass php_fpm;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME /var/www/html/public/index.php;
        fastcgi_param DOCUMENT_ROOT   /var/www/html/public;
        fastcgi_param SCRIPT_NAME     /index.php;
        fastcgi_param REQUEST_URI     $request_uri;
    }

    location ~ ^/index\.php(/|$) {
        fastcgi_pass php_fpm;
        fastcgi_split_path_info ^(.+\.php)(/.*)$;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME /var/www/html/public/index.php;
        fastcgi_param DOCUMENT_ROOT   /var/www/html/public;
        internal;
    }

    # js-скрипты widget
    location ~* ^/widget/(.*\.js)$ {
        alias /var/www/widget/$1;
        add_header Content-Type application/javascript;
    }

    # Файлы widget
    location /widget/ {
        alias /var/www/widget/;
        add_header Access-Control-Allow-Origin "*" always;
        try_files $uri $uri/ =404;
    }

    # ---------- Статика SPA с длинным кэшем ----------
    location ~* \.(?:js|css|woff2|svg|png|jpg|jpeg|gif|ico)$ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # ---------- SPA fallback ----------
    location / {
        try_files $uri $uri/ /index.html;
    }
}
