# Значения по умолчанию. Реальные секреты переопределяются через окружение Docker.
# Порядок приоритета: реальные env-переменные > .env.local > .env

###> symfony/framework-bundle ###
APP_ENV=dev
APP_DEBUG=1
APP_SECRET=changeme_in_production_0123456789abcdef
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# Хост 'mysql' = имя сервиса в docker-compose. serverVersion фиксирован под MySQL 8.4.
DATABASE_URL="mysql://app:app@mysql:3306/mortgage?serverVersion=8.4.0&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> nelmio/cors-bundle ###
# В проде заменить на белый список доменов партнёров, например: '^https?://(.*\.)?partner\.ru$'
CORS_ALLOW_ORIGIN='.*'
###< nelmio/cors-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###
